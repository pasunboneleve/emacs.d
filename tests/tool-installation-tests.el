;;; tool-installation-tests.el --- CLI provisioning and responsiveness -*- lexical-binding: t; -*-
;;; Commentary:
;; Unit tests do not install real SDKs or touch the user's tool directories.
;;; Code:
(require 'ert)
(require 'cl-lib)
(require 'warnings)
(setq load-prefer-newer t)
(defconst be/tools-test-root
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(add-to-list 'load-path (expand-file-name "local-packages" be/tools-test-root))
(require 'be-system)
(require 'be-install)
(require 'be-assets)
(require 'be-lazy)
(require 'be-formatters)

(ert-deftest be/managed-release-platforms ()
  (dolist (case '((gnu/linux "x86_64-pc-linux" "linux" "x86_64")
                  (darwin "aarch64-apple-darwin" "darwin" "aarch64")))
    (let ((system-type (nth 0 case)) (system-configuration (nth 1 case)))
      (should (equal (be/tool-platform) (nthcdr 2 case))))))

(ert-deftest be/native-prerequisites-stay-in-editor ()
  (cl-letf (((symbol-function 'be/system-manager) (lambda () 'apt))
            ((symbol-function 'user-uid) (lambda () 1000)))
    (should (equal (be/native-tool-command "python3" nil)
                   '("sudo" "apt-get" "install" "-y" "python3")))
    (should-not (be/native-tool-command "jdtls" nil))
    (should-not (be/native-tool-command "pyright-langserver" nil))
    (should (equal (be/native-tool-command "rg" 'ripgrep)
                   '("sudo" "apt-get" "install" "-y" "ripgrep")))))

(ert-deftest be/background-install-returns-and-keeps-timers-running ()
  (let* ((root (make-temp-file "emacs-tool-queue-" t))
         (script (expand-file-name "install.sh" root))
         (log (expand-file-name "order" root))
         (be/tool-queue nil) (be/tool-process nil) (be/tool-current nil) (be/tool-status nil)
         (be/tool-installers (make-hash-table :test 'equal))
         (be/tool-callbacks (make-hash-table :test 'equal))
         responsive callbacks)
    (unwind-protect
        (progn
          (with-temp-file script
            (insert "#!/usr/bin/env bash\nset -euo pipefail\nsleep 0.2\nprintf '%s\\n' \"$1\" >> \"$2/order\"\ntouch \"$2/$1\"\n"))
          (cl-letf (((symbol-function 'be/tool-present-p)
                     (lambda (name) (file-exists-p (expand-file-name name root))))
                    ((symbol-function 'be/tool-requirements)
                     (lambda (name) (when (equal name "server") '("runtime"))))
                    ((symbol-function 'be/native-tool-command) (lambda (&rest _) nil))
                    ((symbol-function 'be/tool-worker-command)
                     (lambda (name _) (list "bash" script name root))))
            (let ((noninteractive nil))
              (should-not (be/ensure-tool "server" nil (lambda () (push 'one callbacks))))
              (should-not (be/ensure-tool "server" nil (lambda () (push 'two callbacks)))))
            (should-not (file-exists-p (expand-file-name "server" root)))
            (run-at-time 0.05 nil (lambda () (setq responsive t)))
            (let ((deadline (+ (float-time) 10)))
              (while (and (< (float-time) deadline) (or be/tool-current be/tool-queue))
                (accept-process-output nil 0.02)))
            (should responsive)
            (should (= (length callbacks) 2))
            (should-not be/tool-current)
            (should (equal (with-temp-buffer (insert-file-contents log) (buffer-string))
                           "runtime\nserver\n"))))
      (when (process-live-p be/tool-process) (delete-process be/tool-process))
      (delete-directory root t))))

(ert-deftest be/failed-prerequisite-does-not-launch-dependent ()
  (let ((be/tool-queue '("server")) (be/tool-current nil) (be/tool-process nil)
        (be/tool-callbacks (make-hash-table :test 'equal))
        (be/tool-installers (make-hash-table :test 'equal)) warnings)
    (cl-letf (((symbol-function 'be/tool-present-p) (lambda (_) nil))
              ((symbol-function 'be/tool-requirements) (lambda (_) '("missing-runtime")))
              ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Launched broken server")))
              ((symbol-function 'run-at-time) #'ignore)
              ((symbol-function 'display-warning) (lambda (&rest args) (push args warnings))))
      (be/start-next-tool)
      (should warnings)
      (should-not be/tool-current))))

(ert-deftest be/command-installation-does-not-replay-new-edits ()
  (let (callback ready called)
    (fset 'be/test-tool-command (lambda () (setq called t)))
    (unwind-protect
        (with-temp-buffer
          (cl-letf (((symbol-function 'be/ensure-tool)
                     (lambda (_name _installer cb) (setq callback cb) nil))
                    ((symbol-function 'be/tool-present-p) (lambda (_) ready)))
            (be/command-tools 'be/test-tool-command '("formatter"))
            (be/test-tool-command)
            (should-not called)
            (insert "new edits")
            (setq ready t)
            (funcall callback)
            (should-not called)))
      (fmakunbound 'be/test-tool-command))))

(ert-deftest be/worker-memory-and-cpu-scope ()
  (let ((system-type 'gnu/linux) (process-environment (copy-sequence process-environment)))
    (setenv "DBUS_SESSION_BUS_ADDRESS" "unix:path=/test")
    (cl-letf (((symbol-function 'user-uid) (lambda () 1000))
              ((symbol-function 'executable-find) (lambda (name) (concat "/bin/" name))))
      (let ((command (be/tool-worker-command "tinymist" nil)))
        (should (equal (car command) "systemd-run"))
        (should (member "MemoryMax=2G" command))
        (should (member "CPUQuota=100%" command))
        (should (member "nice" command))
        (should-not (member "Nice=10" command))))))

(ert-deftest be/pending-grammar-is-not-a-failure ()
  (let ((be/grammar-failures nil) (noninteractive nil) requested)
    (cl-letf (((symbol-function 'treesit-available-p) (lambda () t))
              ((symbol-function 'be/grammar-ready-p) (lambda (_) nil))
              ((symbol-function 'be/ensure-tool)
               (lambda (name &rest _) (setq requested name) nil)))
      (should-not (be/ensure-grammar 'json))
      (should (equal requested "grammar:json"))
      (should-not be/grammar-failures))))

(ert-deftest be/grammar-ready-activates-buffer-mode ()
  (let ((auto-mode-alist nil) (be/lazy-associations nil) callback ready)
    (be/lazy-mode be/test-grammar-mode "\\.example\\'" "test.el" be/test-grammar-target json be/test-grammar-fallback)
    (cl-letf (((symbol-function 'be/load-module) #'ignore)
              ((symbol-function 'be/ensure-grammar)
               (lambda (_) (setq callback be/grammar-ready-function) ready))
              ((symbol-function 'be/test-grammar-target) (lambda () (setq major-mode 'be/test-grammar-target)))
              ((symbol-function 'be/test-grammar-fallback) (lambda () (setq major-mode 'be/test-grammar-fallback))))
      (with-temp-buffer
        (setq buffer-file-name "/tmp/test.example")
        (be/test-grammar-mode)
        (should (eq major-mode 'be/test-grammar-fallback))
        (setq ready t)
        (funcall callback)
        (should (eq major-mode 'be/test-grammar-target))))))

(ert-deftest be/project-npx-resolution-is-not-preempted ()
  (let (requested ran)
    (cl-letf (((symbol-function 'be/ensure-tool) (lambda (name &rest _) (push name requested) t)))
      (with-temp-buffer
        (be/apheleia-tools (lambda (&rest _) (setq ran t))
                           '("apheleia-npx" "prettier") (current-buffer) nil #'ignore)))
    (should ran)
    (should (equal requested '("node")))))

(ert-deftest be/npx-fallback-only-after-confirmed-missing ()
  (let (requested)
    (cl-letf (((symbol-function 'apheleia-formatter--remote) (lambda (_) nil))
              ((symbol-function 'apheleia-formatter--arg1) (lambda (_) "apheleia-npx"))
              ((symbol-function 'apheleia-formatter--stdin) (lambda (_) (current-buffer)))
              ((symbol-function 'apheleia-formatter--argv) (lambda (_) '("prettier")))
              ((symbol-function 'be/ensure-tool) (lambda (name &rest _) (push name requested))))
      (should-not (be/apheleia-npx-missing (lambda (&rest _) nil) 'context ""))
      (should-not requested)
      (should (be/apheleia-npx-missing (lambda (&rest _) t) 'context "formatter_not_available"))
      (should (equal requested '("prettier"))))))

(ert-deftest be/wrapper-does-not-overwrite-a-symlink-target ()
  (let* ((root (make-temp-file "emacs-wrapper-test-" t))
         (process-environment (copy-sequence process-environment))
         (target (expand-file-name "original.js" root)))
    (unwind-protect
        (progn
          (setenv "HOME" root)
          (make-directory (expand-file-name "~/.local/bin") t)
          (with-temp-file target (insert "original contents"))
          (make-symbolic-link target (expand-file-name "~/.local/bin/test-tool"))
          (be/tool-wrapper "test-tool" '("echo" "ready"))
          (should-not (file-symlink-p (expand-file-name "~/.local/bin/test-tool")))
          (should (equal (with-temp-buffer (insert-file-contents target) (buffer-string)) "original contents")))
      (delete-directory root t))))

(ert-deftest be/retry-retains-a-custom-installer ()
  (let ((be/tool-current "aider") (be/tool-process nil) (be/tool-queue nil)
        (be/tool-installers (make-hash-table :test 'equal))
        (be/tool-callbacks (make-hash-table :test 'equal))
        (recipe "uv tool install aider-chat"))
    (puthash "aider" recipe be/tool-installers)
    (cl-letf (((symbol-function 'be/tool-present-p) (lambda (_) nil))
              ((symbol-function 'display-warning) #'ignore))
      (be/finish-tool nil "network failure")
      (should (equal (gethash "aider" be/tool-installers) recipe)))
    (should (equal (car (be/tool-installer "aider")) "uv"))))

(ert-deftest be/archive-installs-into-a-new-private-directory ()
  (let* ((root (make-temp-file "emacs-archive-test-" t))
         (process-environment (copy-sequence process-environment))
         (default-directory (file-name-as-directory root))
         (tree (expand-file-name "archive-tree/bin" root))
         (archive (expand-file-name "fixture.tar.gz" root)))
    (unwind-protect
        (progn
          (setenv "HOME" root)
          (make-directory tree t)
          (with-temp-file (expand-file-name "fixture" tree)
            (insert "#!/usr/bin/env bash\nset -euo pipefail\nexit 0\n"))
          (should (zerop (call-process "tar" nil nil nil "-czf" archive "-C" (file-name-directory tree) "bin")))
          (cl-letf (((symbol-function 'url-copy-file) (lambda (_url destination &rest _) (copy-file archive destination t))))
            (let ((binary (be/extract-tool "fixture" "https://example.invalid/archive" "fixture.tar.gz" "fixture")))
              (should (file-executable-p binary))
              (should (zerop (call-process binary))))))
      (delete-directory root t))))

(ert-deftest be/grammar-worker-can-request-a-compiler-without-losing-callback ()
  (let* ((root (make-temp-file "emacs-compiler-queue-" t))
         (script (expand-file-name "worker.sh" root))
         (be/tool-queue nil) (be/tool-process nil) (be/tool-current nil)
         (be/tool-extra-requirements (make-hash-table :test 'equal))
         (be/tool-installers (make-hash-table :test 'equal))
         (be/tool-callbacks (make-hash-table :test 'equal))
         (callbacks 0))
    (unwind-protect
        (progn
          (with-temp-file script
            (insert "#!/usr/bin/env bash\nset -euo pipefail\nprintf '%s\\n' \"$1\" >> \"$2/order\"\nif [[ \"$1\" == grammar:json && ! -e \"$2/c++\" ]]; then\n  echo 'BE_TOOL_PREREQUISITE:c++'\n  exit 1\nfi\ntouch \"$2/$1\"\n"))
          (cl-letf (((symbol-function 'be/tool-present-p)
                     (lambda (name) (or (member name '("git" "cc"))
                                        (file-exists-p (expand-file-name name root)))))
                    ((symbol-function 'be/native-tool-command) (lambda (&rest _) nil))
                    ((symbol-function 'be/tool-worker-command)
                     (lambda (name _) (list "bash" script name root))))
            (let ((noninteractive nil))
              (be/ensure-tool "grammar:json" nil (lambda () (cl-incf callbacks))))
            (let ((deadline (+ (float-time) 10)))
              (while (and (< (float-time) deadline) (or be/tool-current be/tool-queue))
                (accept-process-output nil 0.02)))
            (should (= callbacks 1))
            (should (equal (with-temp-buffer
                             (insert-file-contents (expand-file-name "order" root)) (buffer-string))
                           "grammar:json\nc++\ngrammar:json\n"))))
      (when (process-live-p be/tool-process) (delete-process be/tool-process))
      (delete-directory root t))))

(ert-deftest be/public-release-fallback-selects-the-platform-asset ()
  (cl-letf (((symbol-function 'be/upstream-text)
             (lambda (url)
               (if (string-suffix-p "latest" url)
                   "<a href=\"/vendor/tool/releases/tag/v1.2.3\">release</a>"
                 "<a href=\"/vendor/tool/releases/download/v1.2.3/other.zip\">other</a><a href=\"/vendor/tool/releases/download/v1.2.3/tool-linux.tar.gz\">tool</a>"))))
    (let ((asset (be/github-public-asset "vendor/tool" "\\`tool-linux\\.tar\\.gz\\'")))
      (should (equal (alist-get 'name asset) "tool-linux.tar.gz"))
      (should (equal (alist-get 'browser_download_url asset)
                     "https://github.com/vendor/tool/releases/download/v1.2.3/tool-linux.tar.gz")))))

(ert-deftest be/github-token-is-scoped-to-api-request ()
  (let ((process-environment (copy-sequence process-environment))
        (url-request-extra-headers nil) authenticated fallback)
    (setenv "GH_TOKEN" "test-placeholder")
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (&rest _)
                 (setq authenticated (assoc "Authorization" url-request-extra-headers))
                 (let ((buffer (generate-new-buffer " *release fixture*")))
                   (with-current-buffer buffer (setq-local url-http-response-status 403)) buffer)))
              ((symbol-function 'be/github-public-asset)
               (lambda (&rest _)
                 (should-not (assoc "Authorization" url-request-extra-headers))
                 (setq fallback t) '((name . "fixture")))))
      (should (equal (be/github-asset "vendor/tool" "fixture") '((name . "fixture"))))
    (should authenticated)
    (should fallback))))

(ert-deftest be/java-launcher-resolves-its-real-sdk-home ()
  (let* ((root (make-temp-file "emacs-jdk-home-" t))
         (binary (expand-file-name "bin/java" root)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory binary) t)
          (with-temp-file binary (insert "#!/usr/bin/env bash\nset -euo pipefail\nexit 0\n"))
          (set-file-modes binary #o755)
          (cl-letf (((symbol-function 'executable-find) (lambda (_) "/usr/bin/java"))
                    ((symbol-function 'call-process)
                     (lambda (&rest _)
                       (insert (format "Property settings:\n    java.home = %s\nopenjdk version \"21.0.8\"\n" root))
                       0)))
            (should (equal (be/java-runtime) binary))))
      (delete-directory root t))))

(ert-deftest be/java-runtime-downloads-the-required-major ()
  (cl-letf (((symbol-function 'executable-find) (lambda (_) nil))
            ((symbol-function 'file-directory-p) (lambda (_) nil))
            ((symbol-function 'be/tool-platform) (lambda () '("linux" "x86_64")))
            ((symbol-function 'be/extract-tool)
             (lambda (name url _archive _binary &rest _)
               (should (equal name "jdk-25"))
               (should (string-match-p "/latest/25/ga/linux/x64/" url))
               "/private/jdk-25/bin/java")))
    (should (equal (be/java-runtime 25) "/private/jdk-25/bin/java"))))

(ert-deftest be/cancelling-authentication-releases-the-installation-queue ()
  (let ((be/tool-current nil) (be/tool-process nil) (be/tool-queue '("native" "dependent"))
        (be/tool-installers (make-hash-table :test 'equal))
        (be/tool-callbacks (make-hash-table :test 'equal)))
    (cl-letf (((symbol-function 'be/tool-present-p) (lambda (_) nil))
              ((symbol-function 'be/tool-requirements) (lambda (_) nil))
              ((symbol-function 'be/native-tool-command) (lambda (&rest _) '("true")))
              ((symbol-function 'start-file-process) (lambda (&rest _) (signal 'quit nil)))
              ((symbol-function 'display-warning) #'ignore))
      (be/start-next-tool)
      (should-not be/tool-current)
      (should-not be/tool-process)
      (should-not be/tool-queue))))

(ert-deftest be/macos-finds-keg-only-postgresql-client ()
  (let* ((root (make-temp-file "emacs-libpq-test-" t))
         (system-type 'darwin) (exec-path nil)
         (process-environment (copy-sequence process-environment))
         (binary (expand-file-name "opt/libpq/bin/psql" root)))
    (unwind-protect
        (progn
          (setenv "HOME" root) (setenv "HOMEBREW_PREFIX" root) (setenv "PATH" "")
          (make-directory (file-name-directory binary) t)
          (with-temp-file binary (insert "#!/usr/bin/env bash\nset -euo pipefail\nexit 0\n"))
          (set-file-modes binary #o755)
          (be/tool-paths)
          (should (equal (executable-find "psql") binary)))
      (delete-directory root t))))

(ert-deftest be/worker-loads-fresh-source-over-stale-bytecode ()
  (let* ((root (make-temp-file "emacs-worker-source-" t))
         (source (expand-file-name "be-system.el" root))
         (worker (expand-file-name "be-tool-worker.el" root))
         (marker (expand-file-name "fresh" root))
         (process-environment (copy-sequence process-environment))
         (default-directory (file-name-as-directory root)))
    (unwind-protect
        (progn
          (copy-file be/tool-worker-file worker)
          (with-temp-file source
            (insert "(defun be/ensure-tool (&rest _) (error \"Stale installer\"))\n(provide 'be-system)\n"))
          (byte-compile-file source)
          (set-file-times (concat source "c") (time-subtract (current-time) (seconds-to-time 10)))
          (with-temp-file source
            (insert (format "(defun be/ensure-tool (&rest _) (with-temp-file %S (insert \"fresh\")) t)\n(provide 'be-system)\n" marker)))
          (setenv "BE_TOOL_EMACS_DIRECTORY" root)
          (with-temp-buffer
            (should (zerop (call-process (expand-file-name invocation-name invocation-directory)
                                         nil t nil "-Q" "--batch" "-l" worker "fixture" "nil"))))
          (should (file-exists-p marker)))
      (delete-directory root t))))

(provide 'tool-installation-tests)
