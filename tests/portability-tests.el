;;; portability-tests.el --- Bootstrap behavior tests -*- lexical-binding: t; -*-
;;; Commentary:
;; Run with emacs -Q --batch -l tests/portability-tests.el -f ert-run-tests-batch-and-exit.
;;; Code:
(require 'ert)
(require 'cl-lib)
(setq load-prefer-newer t)
(defconst be/test-root
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(add-to-list 'load-path (expand-file-name "local-packages" be/test-root))
(require 'be-system)
(require 'be-git)
(require 'be-secrets)
;; Queue-accessor fakes must not be bypassed by inlined accessors in an old
;; compiled copy.  The smoke checks separately exercise compiled startup.
(load (expand-file-name "local-packages/be-lazy.el" be/test-root) nil t)
(require 'be-assets)
(require 'be-packages)

(ert-deftest be/native-package-mapping ()
  (cl-letf (((symbol-function 'user-uid) (lambda () 1000)))
    (dolist (case '((apt "sudo" "apt-get" "install" "-y" "build-essential")
                    (dnf "sudo" "dnf" "install" "-y" "gcc")
                    (brew "brew" "install" "llvm")))
      (let ((manager (car case)))
        (cl-letf (((symbol-function 'be/system-manager) (lambda () manager)))
          (should (equal (be/system-install-command "cc") (cdr case))))))))

(ert-deftest be/platform-detection ()
  (dolist (case '((gnu/linux ("apt-get") apt)
                  (gnu/linux ("dnf") dnf)
                  (darwin ("brew") brew)
                  (darwin () nil)))
    (let ((system-type (nth 0 case)))
      (cl-letf (((symbol-function 'executable-find)
                 (lambda (name) (member name (nth 1 case)))))
        (should (eq (be/system-manager) (nth 2 case)))))))

(ert-deftest be/tool-present-does-not-install ()
  (cl-letf (((symbol-function 'executable-find) (lambda (_) "/bin/tool"))
            ((symbol-function 'be/run-installer) (lambda (_) (ert-fail "Unexpected install"))))
    (should (be/ensure-tool 'rg))))

(ert-deftest be/tool-install-waits-and-checks ()
  (let (installed)
    (cl-letf (((symbol-function 'executable-find) (lambda (_) installed))
              ((symbol-function 'be/system-manager) (lambda () 'apt))
              ((symbol-function 'be/run-installer) (lambda (_) (setq installed "/bin/rg"))))
      (should (equal (be/ensure-tool 'rg) "/bin/rg")))))

(ert-deftest be/tool-install-failure-warns ()
  (let (warning)
    (cl-letf (((symbol-function 'executable-find) (lambda (_) nil))
              ((symbol-function 'be/run-installer) (lambda (_) (error "Network unavailable")))
              ((symbol-function 'display-warning) (lambda (_ text &rest _) (setq warning text))))
      (should-not (be/ensure-tool 'example "install example"))
      (should (string-match-p "Network unavailable" warning)))))

(ert-deftest be/remote-buffer-does-not-install ()
  (let ((default-directory "/ssh:example:/tmp/"))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) nil))
              ((symbol-function 'be/run-installer) (lambda (_) (ert-fail "Remote install"))))
      (should-not (be/ensure-tool 'rg)))))

(ert-deftest be/uv-installer-obeys-originating-buffer-policy ()
  (let ((be/allow-tool-installation nil))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) nil))
              ((symbol-function 'be/install-user-script) (lambda (&rest _) (ert-fail "Unexpected installer"))))
      (should-not (be/ensure-uv)))))

(ert-deftest be/python-without-uv-keeps-editing ()
  (cl-letf (((symbol-function 'use-package) (cons 'macro (lambda (&rest _) nil))))
    (load (expand-file-name "mixins/languages/python-config.el" be/test-root) nil t))
  (let (checked continued)
    (cl-letf (((symbol-function 'be/ensure-tool) (lambda (tool &rest _) (setq checked tool) nil))
              ((symbol-function 'uv-mode-auto-activate-hook) (lambda () (ert-fail "UV activated without executable"))))
      (let ((prog-mode-hook (list #'be/python-uv (lambda () (setq continued t)))))
        (run-hooks 'prog-mode-hook))
      (should (eq checked 'uv))
      (should continued))))

(ert-deftest be/transport-fallback-and-upgrade ()
  (let (ready)
    (cl-letf (((symbol-function 'be/ssh-ready-p) (lambda (_) ready)))
      (should (equal (be/git-url "git@github.com:owner/repo.git")
                     "https://github.com/owner/repo.git"))
      (setq ready t)
      (should (equal (be/git-url "https://github.com/owner/repo.git")
                     "git@github.com:owner/repo.git"))
      (should (equal (be/git-url "/local/repo") "/local/repo"))
      (should (equal (be/git-url "ssh://git@private.example/owner/repo")
                     "ssh://git@private.example/owner/repo")))))

(ert-deftest be/ssh-rechecks-after-credentials-change ()
  (let ((be/ssh-checks (make-hash-table :test #'equal)) (now 0) (calls 0))
    (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now))
              ((symbol-function 'executable-find) (lambda (_) t))
              ((symbol-function 'be/ssh-authenticated-p)
               (lambda (_) (cl-incf calls) (> now 60))))
      (should-not (be/ssh-ready-p "github.com"))
      (should-not (be/ssh-ready-p "github.com"))
      (should (= calls 1))
      (setq now 61)
      (should (be/ssh-ready-p "github.com"))
      (should (= calls 2)))))

(ert-deftest be/https-fallback-overrides-global-ssh-rewrite ()
  (let ((configuration (make-temp-file "emacs-git-test-"))
        (process-environment (copy-sequence process-environment))
        (url "https://github.com/example/repo.git"))
    (unwind-protect
        (progn
          (with-temp-file configuration
            (insert "[url \"git@github.com:\"]\n\tinsteadOf = https://github.com/\n"))
          (setenv "GIT_CONFIG_GLOBAL" configuration)
          (setenv "GIT_CONFIG_NOSYSTEM" "1")
          (should (equal (car (process-lines "git" "ls-remote" "--get-url" url))
                         "git@github.com:example/repo.git"))
          (should (equal (car (be/with-git-urls (list url) #'process-lines
						"git" "ls-remote" "--get-url" url))
                         url)))
      (delete-file configuration))))

(ert-deftest be/ssh-probe-is-not-reentered-by-package-callback ()
  (let ((be/ssh-checks (make-hash-table :test #'equal)) (calls 0))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
              ((symbol-function 'be/ssh-authenticated-p)
               (lambda (host)
                 (cl-incf calls)
                 (should-not (be/ssh-ready-p host))
                 t)))
      (should (be/ssh-ready-p "github.com"))
      (should (= calls 1)))))

(ert-deftest be/lazy-module-loads-once ()
  (let ((be/loaded-modules nil) (calls 0))
    (cl-letf (((symbol-function 'load) (lambda (&rest _) (cl-incf calls)))
              ((symbol-function 'elpaca-wait) #'ignore)
              ((symbol-function 'elpaca--queued) (lambda () nil)))
      (be/load-module "example.el")
      (be/load-module "example.el")
      (should (= calls 1)))))

(ert-deftest be/lazy-module-failure-can-retry ()
  (let ((be/loaded-modules nil) (calls 0))
    (cl-letf (((symbol-function 'load) (lambda (&rest _) (cl-incf calls) (error "Unavailable")))
              ((symbol-function 'elpaca-wait) #'ignore)
              ((symbol-function 'elpaca--queued) (lambda () nil)))
      (should-error (be/load-module "example.el"))
      (should-error (be/load-module "example.el"))
      (should (= calls 2))
      (should-not be/loaded-modules))))

(ert-deftest be/unrelated-package-failure-does-not-block-module ()
  (let ((be/loaded-modules nil) (entries '((old-package . failed))))
    (cl-letf (((symbol-function 'load)
               (lambda (&rest _) (push '(new-package . finished) entries)))
              ((symbol-function 'elpaca-wait) #'ignore)
              ((symbol-function 'elpaca--queued) (lambda () entries))
              ((symbol-function 'elpaca<-status) #'identity))
      (be/load-module "example.el")
      (should (member "example.el" be/loaded-modules)))))

(ert-deftest be/language-registration-installs-nothing ()
  (let ((auto-mode-alist nil) (interpreter-mode-alist nil)
        (be/lazy-associations nil)
        (emacs-lisp-mode-hook nil)
        (user-emacs-directory be/test-root))
    (cl-letf (((symbol-function 'use-package) (cons 'macro (lambda (&rest _) nil)))
              ((symbol-function 'be/run-installer) (lambda (_) (ert-fail "Unexpected install"))))
      (load (expand-file-name "mixins/languages.el" be/test-root) nil t)
      (should (eq (cdr (assoc "\\.\\(?:cl\\|lisp\\)\\'" auto-mode-alist)) 'be/lisp-mode))
      (should-not (featurep 'sly))
      (should (commandp 'be/python-mode)))))

(ert-deftest be/missing-grammar-falls-back ()
  (let ((auto-mode-alist nil) (be/lazy-associations nil) entered)
    (be/lazy-mode be/test-mode "\\.example\\'" "example.el" be/test-target example be/test-fallback)
    (cl-letf (((symbol-function 'be/load-module) #'ignore)
              ((symbol-function 'be/ensure-grammar) (lambda (_) nil))
              ((symbol-function 'be/test-target) (lambda () (ert-fail "Missing grammar used")))
              ((symbol-function 'be/test-fallback) (lambda () (setq entered t))))
      (be/test-mode)
      (should entered))))

(ert-deftest be/grammar-already-present-does-not-build ()
  (let* ((directory (make-temp-file "emacs-grammar-test-" t))
         (treesit-extra-load-path nil))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "libtree-sitter-python.so" directory))
          (cl-letf (((symbol-function 'be/grammar-directory) (lambda (&rest _) directory))
		    ((symbol-function 'treesit-available-p) (lambda () t))
		    ((symbol-function 'treesit-language-available-p) (lambda (_) t))
		    ((symbol-function 'treesit-install-language-grammar) (lambda (_) (ert-fail "Unneeded build"))))
            (should (be/ensure-grammar 'python))))
      (delete-directory directory t))))

(ert-deftest be/grammar-failure-is-not-repeated ()
  (let ((be/grammar-failures nil) (calls 0)
        (directory (make-temp-file "emacs-grammar-test-" t)))
    (unwind-protect
	(cl-letf (((symbol-function 'treesit-available-p) (lambda () t))
		  ((symbol-function 'be/grammar-directory) (lambda (&rest _) directory))
		  ((symbol-function 'treesit-language-available-p) (lambda (_) nil))
		  ((symbol-function 'be/ensure-tool) (lambda (&rest _) t))
		  ((symbol-function 'be/git-url) #'identity)
		  ((symbol-function 'treesit-install-language-grammar)
		   (lambda (&rest _) (cl-incf calls) (error "Compiler failed")))
		  ((symbol-function 'display-warning) #'ignore))
	  (should-not (be/ensure-grammar 'python))
	  (should-not (be/ensure-grammar 'python))
	  (should (= calls 1)))
      (delete-directory directory t))))

(ert-deftest be/package-autoload-cannot-bypass-another-lazy-mode ()
  (let ((auto-mode-alist nil) (be/lazy-associations nil))
    (be/lazy-mode be/test-markdown "\\.md\\'" "markdown.el" markdown-mode)
    (push '("\\.md\\'" . markdown-mode) auto-mode-alist)
    (be/restore-lazy-modes)
    (should (eq (cdr (assoc "\\.md\\'" auto-mode-alist)) 'be/test-markdown))))

(ert-deftest be/remote-module-keeps-installation-policy-in-local-callback ()
  (let ((default-directory "/ssh:example:/tmp/")
        (be/loaded-modules nil) installed)
    (cl-letf (((symbol-function 'elpaca--queued) (lambda () nil))
              ((symbol-function 'elpaca-wait) #'ignore)
              ((symbol-function 'executable-find) (lambda (_) nil))
              ((symbol-function 'be/run-installer) (lambda (_) (setq installed t)))
              ((symbol-function 'load)
               (lambda (&rest _)
                 (let ((default-directory temporary-file-directory))
                   (be/ensure-tool 'example "install example")))))
      (be/load-module "example.el")
      (should-not installed))))

(ert-deftest be/parinfer-failure-keeps-remaining-mode-hooks ()
  (let (warned next-hook)
    (let ((auto-mode-alist nil) (interpreter-mode-alist nil)
          (be/lazy-associations nil) (emacs-lisp-mode-hook nil))
      (cl-letf (((symbol-function 'use-package) (cons 'macro (lambda (&rest _) nil))))
        (load (expand-file-name "mixins/languages.el" be/test-root) nil t)))
    (cl-letf (((symbol-function 'be/load-module) (lambda (_) (error "Unavailable")))
              ((symbol-function 'display-warning) (lambda (&rest _) (setq warned t))))
      (let ((emacs-lisp-mode-hook (list #'be/parinfer-mode (lambda () (setq next-hook t)))))
        (run-hooks 'emacs-lisp-mode-hook))
      (should warned)
      (should next-hook))))

(ert-deftest be/terminal-does-not-install-fonts ()
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil))
            ((symbol-function 'all-the-icons-install-fonts) (lambda (&rest _) (ert-fail "Unexpected fonts"))))
    (be/ensure-icon-fonts)))

(ert-deftest be/graphical-frame-installs-fonts-once ()
  (let ((be/fonts-ready nil) installed (calls 0))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'require) (lambda (&rest _) t))
              ((symbol-function 'find-font)
               (lambda (font &rest _) (member (font-get font :family) installed)))
              ((symbol-function 'all-the-icons-install-fonts)
               (lambda (force) (should force) (cl-incf calls) (push "all-the-icons" installed)))
              ((symbol-function 'nerd-icons-install-fonts)
               (lambda (force) (should force) (cl-incf calls) (push "Symbols Nerd Font Mono" installed))))
      (be/ensure-icon-fonts)
      (be/ensure-icon-fonts)
      (should be/fonts-ready)
      (should (= calls 2)))))

(ert-deftest be/emacs29-grammar-output-directory ()
  (let (received)
    (cl-letf (((symbol-function 'treesit-install-language-grammar) (lambda (_language)))
              ((symbol-function 'treesit--install-language-grammar-1)
               (lambda (&rest args) (setq received args))))
      (be/install-grammar 'json "/cache/json/" '(json "https://example.test/json" "v1"))
      (should (equal received '("/cache/json/" json "https://example.test/json" "v1"))))))

(ert-deftest be/unreadable-secrets-are-not-loaded ()
  (let (warned)
    (cl-letf (((symbol-function 'file-exists-p) (lambda (_) t))
              ((symbol-function 'be/can-decrypt-p) (lambda (_) nil))
              ((symbol-function 'load) (lambda (&rest _) (ert-fail "Attempted decryption")))
              ((symbol-function 'display-warning) (lambda (&rest _) (setq warned t))))
      (be/load-optional-user-file "other-machine.el.gpg")
      (should warned))))

(ert-deftest be/emacs29-compatibility-exception ()
  (let ((emacs-major-version 29))
    (should (equal (be/package-compatibility '(:package "casual")) '(:tag "2.14.0"))))
  (let ((emacs-major-version 31))
    (should-not (be/package-compatibility '(:package "casual")))))

(ert-deftest be/build-concurrency-is-scoped ()
  (let ((process-environment (copy-sequence process-environment)))
    (setenv "CARGO_BUILD_JOBS" "16")
    (be/with-build-limits
     (lambda ()
       (should (equal (getenv "CARGO_BUILD_JOBS") "2"))
       (should (equal (getenv "CMAKE_BUILD_PARALLEL_LEVEL") "2"))
       (should (equal (getenv "MAKEFLAGS") "-j2"))))
    (should (equal (getenv "CARGO_BUILD_JOBS") "16"))))

(ert-deftest be/core-recipe-handles-renamed-upstream ()
  (should (equal (plist-get
                  (be/package-compatibility
                   '(:package "project" :repo ("https://github.com/emacs-mirror/emacs" . "project")))
                  :repo)
                 "https://github.com/emacs-straight/project")))

(ert-deftest be/ubuntu293-compatibility-exception ()
  (let ((emacs-version "29.3"))
    (should (equal (be/package-compatibility '(:package "consult-gh")) '(:tag "v2.0"))))
  (let ((emacs-version "29.4"))
    (should-not (be/package-compatibility '(:package "consult-gh")))))

(provide 'portability-tests)
